<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /admin1/

# If requesting /blog without .php, rewrite to blog.php
RewriteRule ^blog/?$ blog.php [L,QSA]

# If requesting /login without .php, rewrite to login.php
RewriteRule ^login/?$ login.php [L,QSA]

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route API endpoints (posts, products, users, categories, tags, analytics) to index.php
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>
